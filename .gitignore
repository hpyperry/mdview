# Python 字节码与缓存
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust 构建产物
/target/

# 虚拟环境（本项目零依赖，出现即代表本地临时试验）
.venv/
venv/
env/

# macOS 元数据
.DS_Store
._*

# 编辑器/IDE
.idea/
.vscode/
*.swp
*~

# 测试产生的临时文件。tests/selftest.sh 的日志都写到 $TMPDIR，
# 正常不会落到仓库里；这里只兜底手工调试时留下的痕迹。
/tmp-*
/tests/*.log
/tests/tmp-*
